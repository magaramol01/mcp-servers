# Transport
VOYAGE_MANAGEMENT_MCP_HOST=0.0.0.0
VOYAGE_MANAGEMENT_MCP_PORT=3010
LOG_LEVEL=info

# Voyage Management Service — this package's own outgoing credential.
# VMS must add this exact value to its own INTERNAL_GATEWAY_KEYS allow-list
# (a third caller identity, distinct from VPM_BFF's and Voyage Agent's own
# keys — see Plan/voyage-agent-service-plan.md Section 9a).
VOYAGE_MANAGEMENT_SERVICE_BASE_URL=http://localhost:8082
VOYAGE_MANAGEMENT_SERVICE_GATEWAY_KEY=replace-with-mcp-voyage-management-dev-key

# Reports Agent — same pattern.
REPORTS_AGENT_BASE_URL=http://localhost:8083
REPORTS_AGENT_GATEWAY_KEY=replace-with-mcp-voyage-management-dev-key

# Alert Agent — not configured yet. alert_agent is not registered as a tool
# in this package (see README.md) because Alert Agent has no running
# service or documented REST API yet (Plan/alert-agent-service-plan.md has
# no concrete routes, only a module-structure sketch). Add these once that
# changes.
# ALERT_AGENT_BASE_URL=
# ALERT_AGENT_GATEWAY_KEY=
